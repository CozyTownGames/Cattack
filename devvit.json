{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "cattack-game",
  "marketingAssets": {
    "icon": "public/assets/app-icon.png"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "reddit": {
      "scope": "moderator",
      "asUser": ["SUBMIT_POST", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "cattack-game",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Post Booster Pack",
        "description": "Force post the daily booster pack scene",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-booster-pack"
      },
      {
        "label": "Example form",
        "description": "Show a simple form",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/example-form"
      }
    ]
  },
  "forms": {
    "exampleForm": "/internal/form/example-submit"
  },
  "scheduler": {
    "tasks": {
      "daily-free-booster": {
        "endpoint": "/internal/scheduler/daily-run-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "cattack_game_dev"
  }
}
